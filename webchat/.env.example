# Copy to .env. Secret values are not committed. The local platform key is in the root README.
NORTHSTAR_API_KEY=
WEBCHAT_PEPPER=

# Optional, with defaults for local running.
NORTHSTAR_PLATFORM_URL=http://localhost:4010
NORTHSTAR_PUBLIC_PLATFORM_URL=http://localhost:4010
NORTHSTAR_SITE_URL=http://localhost:4173
WEBCHAT_ALLOWED_ORIGIN=http://localhost:4173
# Development only. Set to 1, then add ?inspector=1 to a page URL.
WEBCHAT_DEV_INSPECTOR=0
WEBCHAT_DATABASE_URL=sqlite:///webchat.sqlite3
# DEBUG, INFO, WARNING, or ERROR. Operational logs go to stderr as JSON lines.
WEBCHAT_LOG_LEVEL=INFO

# Any OpenAI-compatible endpoint. With no base URL or model, chat runs in degraded mode.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=
LLM_REASONING_EFFORT=none
